# Supabase 配置

# === 线上正式环境配置 ===
# 打包构建时自动使用这些配置，确保线上环境访问正式数据库
# 在 Netlify 环境变量中配置的 VITE_PROD_* 会覆盖这些值
VITE_PROD_SUPABASE_URL=
VITE_PROD_SUPABASE_ANON_KEY=

# === 开发环境配置（可选）===
# 本地开发时使用，留空则使用用户在设置页面配置的值
# VITE_DEV_SUPABASE_URL=
# VITE_DEV_SUPABASE_ANON_KEY=

# 存储桶名称（固定为 customer-files）
# 需要在 Supabase Dashboard → Storage 中创建
# 访问权限设置为 Private（私有）